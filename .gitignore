# ============================================================
# WiFi CSI Home Sensing — Monorepo .gitignore
# ============================================================

# ─── Python (sensor-backend) ───────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
dist/
build/
*.egg

# ─── Node / Next.js (web-app) ──────────────────────────────
node_modules/
.next/
out/
.nuxt/
dist/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ─── ESP32 / ESP-IDF (firmware) ────────────────────────────
firmware/build/
firmware/.cache/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
*.elf
*.bin
*.map
*.lst
*.d

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ─── IDE ────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.sublime-workspace

# ─── Secrets / Env ─────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
secrets.json
wifi_credentials.h

# ─── Logs ──────────────────────────────────────────────────
*.log
logs/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
